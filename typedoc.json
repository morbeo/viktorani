{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "expand",
  "entryPoints": [
    "src/transport",
    "src/db",
    "src/hooks",
    "src/types",
    "src/lib/app-settings.ts",
    "src/lib/theme.ts",
    "src/widgets/layouts.ts",
    "src/components/game-settings/game-settings.ts"
  ],
  "exclude": [
    "src/test/**",
    "src/pages/**",
    "**/*.test.*",
    "src/hooks/useNavigation.ts",
    "src/hooks/useKeyNav.ts",
    "src/hooks/useLocalStorage.ts"
  ],
  "out": "docs/api",
  "name": "Viktorani API",
  "readme": "none",
  "includeVersion": true,
  "disableSources": false,
  "treatWarningsAsErrors": true
}
